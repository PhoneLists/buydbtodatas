}

.contact-card p{
    color:#667085;
    font-size:14px;
    margin-bottom:15px;
}

.contact-card a{
    color:#1264d8;
    font-weight:700;
}


/* =========================
   FOOTER
========================= */

footer{
    background:#080d18;
    color:#fff;
    text-align:center;
    padding:38px 20px;
}

.footer-logo{
    font-size:27px;
    font-weight:800;
    color:#55b8ff;
}

.footer-logo span{
    color:#fff;
}

