    color:#e8f1ff;
}

.hero-buttons{
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
}

.hero-btn{
    display:inline-block;
    background:#fff;
    color:#0759c9;
    padding:13px 25px;
    border-radius:7px;
    font-weight:700;
}

.hero-btn.secondary{
    background:transparent;
    border:1px solid rgba(255,255,255,.6);
    color:#fff;
}


/* =========================
   GENERAL
========================= */

.container{
    max-width:1200px;
    margin:auto;
    padding:70px 20px;
}

.section-title{
    text-align:center;
    margin-bottom:42px;
}

.section-title h2{
    font-size:34px;
    color:#101828;
    margin-bottom:10px;
}

.section-title p{
    color:#667085;
}


/* =========================
   CATEGORY CARDS
========================= */

.category-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.category-card{
    background:#fff;
    border:1px solid #e4e7ec;
    border-radius:14px;
    padding:28px;
    box-shadow:0 5px 20px rgba(16,24,40,.05);
    transition:.25s;
}

.category-card:hover{
    transform:translateY(-5px);
    box-shadow:0 15px 35px rgba(16,24,40,.10);
}

.category-icon{
    width:52px;
    height:52px;
    border-radius:11px;
    background:#eaf2ff;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:25px;
    margin-bottom:17px;
}

.category-card h3{
    color:#101828;
    margin-bottom:9px;
}

.category-card p{
    color:#667085;
    font-size:14px;
    margin-bottom:18px;
}

.category-card a{
    color:#1264d8;
    font-size:14px;
    font-weight:700;
}


/* =========================
   DATA SECTIONS
========================= */

.data-section{
    border-top:1px solid #e5e7eb;
    background:#fff;
}

.data-section:nth-of-type(even){
    background:#f8fafc;
}

.link-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:14px;
}

.data-link{
    background:#fff;
    border:1px solid #e1e5eb;
    border-radius:9px;
    padding:16px;
    color:#344054;
    font-size:14px;
    font-weight:600;
    transition:.2s;
}

.data-link:hover{
    color:#1264d8;
    border-color:#1264d8;
    transform:translateY(-2px);
    box-shadow:0 5px 15px rgba(18,100,216,.08);
}


/* =========================
   ABOUT
========================= */

