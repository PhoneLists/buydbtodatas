}

.top-contact{
    display:flex;
    flex-wrap:wrap;
    gap:18px;
}

.top-contact a{
    color:#fff;
    font-weight:600;
}

.top-contact a:hover{
    color:#55d6ff;
}


/* =========================
   HEADER
========================= */

header{
    background:#ffffff;
    border-bottom:1px solid #e4e7ec;
    position:sticky;
    top:0;
    z-index:999;
}

.navbar{
    max-width:1250px;
    margin:auto;
    padding:16px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
}

.logo{
    font-size:28px;
    font-weight:800;
    color:#1264d8;
    white-space:nowrap;
}

.logo span{
    color:#101828;
}

.nav-menu{
    display:flex;
    align-items:center;
    justify-content:center;
    flex-wrap:wrap;
    gap:5px;
    list-style:none;
}

.nav-menu a{
    display:block;
    color:#344054;
    padding:9px 11px;
    border-radius:7px;
    font-size:13px;
    font-weight:600;
}

.nav-menu a:hover{
    background:#1264d8;
    color:#fff;
}


/* =========================
   HERO
========================= */

.hero{
    background:
    linear-gradient(135deg,#0759c9,#123d86);
    color:#fff;
    padding:95px 20px;
    text-align:center;
}

.hero-content{
    max-width:900px;
    margin:auto;
}

.hero h1{
    font-size:50px;
    line-height:1.15;
